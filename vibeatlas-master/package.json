{
  "name": "personal-cartographer",
  "private": true,
  "scripts": {
    "prestart": "kill-port 3001 5173",
    "start": "concurrently \"npm run start --prefix backend\" \"npm run start --prefix frontend\"",
    "dev": "npm run start",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run start --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "kill-port": "^2.0.1"
  }
}
